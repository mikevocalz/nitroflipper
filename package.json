{
  "name": "nitro-flipper",
  "version": "0.0.1",
  "description": "Cross-platform native page-curl flipper powered by Nitro modules",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "cpp",
    "nitro",
    "ios",
    "android",
    "lib",
    "react-native.config.js"
  ],
  "scripts": {
    "build": "tsc --noEmit false --declaration true --outDir lib",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:cpp",
    "test:cpp": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --target pagecurlsolver_test && ./build/tests/pagecurlsolver_test",
    "nitrogen": "npx nitrogen"
  },
  "keywords": [
    "react-native",
    "nitro",
    "page-curl",
    "ebook",
    "skia"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.86.3"
  },
  "devDependencies": {
    "react-native-nitro-modules": "0.37.1",
    "typescript": "^5.5.4",
    "@types/react": "^18.3.0"
  },
  "dependencies": {}
}
