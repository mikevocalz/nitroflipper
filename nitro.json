        "implementationClassName": "HybridPageCurlSolver"
      }
    },
    "ComicArchiveSource": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridComicArchiveSource"
      }
    },
    "MuPDFFactory": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridMuPDFFactory"
      }
    }
  }
}
